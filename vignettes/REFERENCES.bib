@article{rubin1977,
  title = {Assignment to {{Treatment Group}} on the {{Basis}} of a {{Covariate}}},
  author = {Rubin, Donald B.},
  year = 1977,
  journal = {Journal of Educational Statistics},
  volume = {2},
  number = {1},
  eprint = {1164933},
  eprinttype = {jstor},
