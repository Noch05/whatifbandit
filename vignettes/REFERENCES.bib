@online{athey2022,
  title = {Contextual {{Bandits}} in a {{Survey Experiment}} on {{Charitable Giving}}: {{Within-Experiment Outcomes}} versus {{Policy Learning}}},
  shorttitle = {Contextual {{Bandits}} in a {{Survey Experiment}} on {{Charitable Giving}}},
  author = {Athey, Susan and Byambadalai, Undral and Hadad, Vitor and Krishnamurthy, Sanath Kumar and Leung, Weiwen and Williams, Joseph Jay},
  date = {2022-11-22},
  eprint = {2211.12004},
  eprinttype = {arXiv},
